<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.passport.editor">

    <!-- Permissions for reading external storage (if selecting PDFs from device) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Permission to query content provider for files -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PassportEditor">

        <!-- Main launcher activity for PrismPDF -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:hardwareAccelerated="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Passport Editor Activity for document editing -->
        <activity
            android:name=".PassportEditorActivity"
            android:exported="false"
            android:hardwareAccelerated="true" />

        <!-- Optional: Secondary activity for selecting PDF source -->
        <activity
            android:name=".PDFSelectionActivity"
            android:exported="false"
            android:hardwareAccelerated="true" />

    </application>

</manifest>